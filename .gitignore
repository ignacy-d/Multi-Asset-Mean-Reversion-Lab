# Python and tooling
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Editors, operating systems, and local secrets
.idea/
.vscode/
.DS_Store
.env
.env.*
!.env.example

# Immutable source data and reproducible derivatives are managed explicitly.
data/raw/**
data/processed/**
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated experiment artifacts
results/**
!results/.gitkeep
